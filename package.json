{
	"name": "n8n-nodes-weio",
	"version": "0.1.1",
	"description": "n8n community node for the Weio website-facts API: check a website HTTPS certificate (free tier, no key) and read public business contact facts (API key). Made by Weio, Inc.",
	"license": "MIT",
	"homepage": "https://weio.ai/services/site-check-api.html?utm_source=npm&utm_medium=n8n-node",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"website",
		"ssl",
		"https",
		"lead-enrichment",
		"contact-finder"
	],
	"author": {
		"name": "Weio, Inc.",
		"email": "sales@weio.ai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/weioai/n8n-nodes-weio.git"
	},
	"bugs": {
		"url": "https://github.com/weioai/n8n-nodes-weio/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/WeioApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Weio/Weio.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
